rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "c7zQYjPfidMMBWMghtfudfcmdaw1" ||
        request.auth.token.email == "blameboyop@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "blameboyop@gmail.com" ||
        request.auth.token.email == "owner1@gmail.com" ||
        request.auth.token.email == "owner2@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- USERS ---
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        !('role' in incoming()) || incoming().role == 'user'
      );
      allow update: if (isOwner(userId) && isValidUser(incoming()) && (
        // Prevent self-elevating coins/diamonds, banning self, or modifying role
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'bio', 'avatar', 'tags', 'preferredGame', 
          'favoriteGame', 'matches', 'wins', 'kdRatio', 'headshotPercentage', 
          'updatedAt', 'ingameName', 'fullName', 'age', 'experience', 
          'profileCompleted', 'onboardingStep', 'fcmToken', 'purchasedLogos',
          'playerStatus', 'stats', 'lastStatsUpdatedAt', 'hiddenBadges', 'revokedBadges',
          'gameplayRole'
        ])
      )) || (isAdmin() && (
        // Any admin can update user if role is unchanged
        incoming().get('role', 'user') == existing().get('role', 'user') || (
          // Only Super Admin can change the role, target is not another Super Admin, and new role is supported
          isSuperAdmin() &&
          !(existing().get('email', '') in ["blameboyop@gmail.com", "owner1@gmail.com", "owner2@gmail.com"]) &&
          incoming().get('role', 'user') in ['user', 'moderator', 'admin', 'verified_organizer', 'organizer']
        )
      ));

      function isValidUser(data) {
        return data.name is string && data.name.size() <= 100 &&
               (data.bio == null || (data.bio is string && data.bio.size() <= 500)) &&
               (data.avatar == null || (data.avatar is string && data.avatar.size() <= 1000));
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- CHATS & MESSAGES ---
    match /chats/{chatId} {
      // allow get even if document doesn't exist so client can check existence
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in incoming().participants) && isValidChatThread(incoming());
      allow update: if isSignedIn() && (request.auth.uid in existing().participants || isAdmin()) && isValidChatThread(incoming());
      
      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
        allow create: if isSignedIn() && 
                      (incoming().senderId == request.auth.uid || (incoming().senderId == 'support_ai' && chatId.matches('^support_ai_.*'))) &&
                      isValidMessage(incoming()) &&
                      (getAfter(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
      }
    }

    function isValidChatThread(data) {
      return data.participants is list && data.participants.size() >= 1 &&
             data.lastTimestamp != null &&
             (data.lastMessage == null || (data.lastMessage is string && data.lastMessage.size() <= 5000)) &&
             (data.lastSenderId == null || data.lastSenderId is string) &&
             (data.unreadCount == null || data.unreadCount is map);
    }

    function isValidMessage(data) {
      return data.text is string && data.text.size() <= 5000 &&
             data.senderId is string &&
             data.senderName is string &&
             data.timestamp != null &&
             (data.type == null || data.type in ['text', 'image', 'system']);
    }

    // --- TEAMS ---
    match /teams/{teamId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().leaderId == request.auth.uid;
      allow update: if (isSignedIn() && (existing().leaderId == request.auth.uid || isAdmin()));
    }

    // --- MEMBERSHIPS & FOLLOWS ---
    match /memberships/{id} {
      allow get, list: if isSignedIn(); 
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /follows/{id} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /user_follows/{id} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().followerId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().followerId == request.auth.uid || isAdmin());
    }

    // --- SYSTEM LOGS ---
    match /system_logs/{logId} {
      allow create: if true;
      allow get, list: if isAdmin();
    }

    // --- MATCH SUBMISSIONS ---
    match /match_submissions/{submissionId} {
      allow get, list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- TOURNAMENTS ---
    match /tournaments/{tourId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tournament_participants/{partId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- TASKS ---
    match /tasks/{taskId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /user_tasks/{utId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && exists(/databases/$(database)/documents/tasks/$(incoming().taskId));
    }

    // --- ENDORSEMENTS ---
    match /endorsements/{endId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
    }

    // --- SYSTEM CONFIG ---
    match /system/config {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // --- ADMINS ---
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow write: if false; 
    }

    // --- MISC ---
    match /reports/{reportId} {
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.reportedId == request.auth.uid);
    }

    match /announcements/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /global_chats/{id} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
    }
    
    match /usernames/{id} {
      allow get, list: if true;
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
    }

    match /logos/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /shop_items/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /leaderboards/{id} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- COMPLAINTS ---
    match /complaints/{id} {
      allow create: if isSignedIn(); // Users can log complaints (via AI)
      allow get, list: if isAdmin();
    }

    // --- DEFAULT DENY (MOVED TO BOTTOM) ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
